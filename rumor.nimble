version     = "0.1.0"
author      = "daveey"
description = "Rumor: ten cogs on a hidden social graph, ten noisy clues, two or three of them paid to mislead. Five rounds of neighbour-only talk, then a sealed vote; a policy is just a prompt."
license     = "MIT"

srcDir = "src"

requires "nim >= 2.2.4"
requires "bitworld >= 0.1.0"
requires "mummy >= 0.4.7"
requires "curly >= 1.1.1"
requires "whisky"
